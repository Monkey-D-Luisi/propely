{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Security": {
    "AllowAnonymous": true
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "propely",
    "Password": "",
    "VirtualHost": "/",
    "EventsExchange": "contacts.events"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Enabled": true,
    "DefaultTtlMinutes": 5,
    "KeyPrefix": "contactsapi:"
  },
  "OutboxDispatcher": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Propely.ContactsApi.Infrastructure.Messaging": "Debug"
    }
  }
}
