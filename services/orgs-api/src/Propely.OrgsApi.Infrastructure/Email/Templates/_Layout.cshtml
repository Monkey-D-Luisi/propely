@model Propely.OrgsApi.Application.Common.Email.LayoutEmailModel
<!doctype html>
<html lang="@Model.Locale">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.AppName</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #f5f6f8;
            font-family: Arial, Helvetica, sans-serif;
            color: #1f2937;
        }

        .wrapper {
            width: 100%;
            padding: 24px 12px;
        }

        .card {
            max-width: 640px;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            overflow: hidden;
        }

        .header {
            background: #111827;
            color: #ffffff;
            padding: 16px 24px;
            font-size: 18px;
            font-weight: 700;
        }

        .content {
            padding: 24px;
            line-height: 1.55;
            font-size: 14px;
        }

        .button {
            display: inline-block;
            background: #2563eb;
            color: #ffffff !important;
            text-decoration: none;
            padding: 10px 14px;
            border-radius: 6px;
            font-weight: 600;
            margin: 12px 0;
        }

        .footer {
            border-top: 1px solid #e5e7eb;
            padding: 16px 24px;
            font-size: 12px;
            color: #6b7280;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="card">
            <div class="header">@Model.AppName</div>
            <div class="content">
                @Raw(Model.BodyHtml)
            </div>
            <div class="footer">
                @Model.FooterHelpPrefix <a href="@Model.SupportUrl">@Model.SupportUrl</a>.<br />
                &copy; @Model.Year @Model.AppName
            </div>
        </div>
    </div>
</body>
</html>
