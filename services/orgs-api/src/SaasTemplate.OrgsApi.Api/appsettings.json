{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "orgs-api",
    "Audience": "saas-template"
  },
  "Auth": {
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "GitHub": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{{\"error\":\"RATE_LIMIT_EXCEEDED\"}}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      {
        "Endpoint": "post:/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "post:/auth/forgot-password",
        "Period": "1m",
        "Limit": 3
      },
      {
        "Endpoint": "post:/auth/register",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "post:/auth/resend-verification",
        "Period": "5m",
        "Limit": 1
      },
      {
        "Endpoint": "delete:/orgs/*",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      }
    ]
  },
  "Email": {
    "Provider": "smtp",
    "DefaultLocale": "en"
  },
  "SendGrid": {
    "ApiKey": "",
    "From": "",
    "FromName": "SaaS Starter Kit"
  },
  "Billing": {
    "Mode": "free",
    "Stripe": {
      "SecretKey": "",
      "PublishableKey": "",
      "WebhookSecret": ""
    },
    "Plans": [
      { "Id": "free", "Name": "Free", "StripePriceId": "", "MaxMembers": 5, "MaxOrganizations": 1, "Features": ["5 members", "1 org"] },
      { "Id": "pro", "Name": "Pro", "StripePriceId": "", "MaxMembers": 0, "MaxOrganizations": 5, "Features": ["Unlimited members", "5 orgs"] },
      { "Id": "enterprise", "Name": "Enterprise", "StripePriceId": "", "MaxMembers": 0, "MaxOrganizations": 0, "Features": ["Unlimited everything"] }
    ]
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "saastemplate",
    "Password": "",
    "VirtualHost": "/",
    "WorkItemsExchange": "orgs.events",
    "ConnectionTimeoutSeconds": 30
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Enabled": true,
    "DefaultTtlMinutes": 5,
    "KeyPrefix": "orgsapi:"
  },
  "OutboxDispatcher": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 100
  },
  "FeatureFlags": {
    "Notifications": true,
    "DarkMode": false,
    "BetaFeatures": false,
    "MaintenanceMode": false,
    "UpdateCheck": false
  },
  "Version": {
    "Current": "1.0.0",
    "GitHubRepo": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.HealthChecks": "Error"
    }
  },
  "AllowedHosts": "*"
}
