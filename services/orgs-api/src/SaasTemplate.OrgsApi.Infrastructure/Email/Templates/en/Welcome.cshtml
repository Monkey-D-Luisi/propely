@model SaasTemplate.OrgsApi.Application.Common.Email.WelcomeEmailModel
<h2>Welcome, @Model.UserName!</h2>
<p>Thanks for joining <strong>@Model.AppName</strong>. Your account is ready.</p>
<p>Use the button below to sign in and get started:</p>
<p>
    <a class="button" href="@Model.LoginUrl">Go to @Model.AppName</a>
</p>
<p>If the button does not work, copy this URL into your browser:</p>
<p><a href="@Model.LoginUrl">@Model.LoginUrl</a></p>
