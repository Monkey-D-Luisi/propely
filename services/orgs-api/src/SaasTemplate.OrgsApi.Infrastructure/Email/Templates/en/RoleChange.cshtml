@model SaasTemplate.OrgsApi.Application.Common.Email.RoleChangeEmailModel
<h2>Your role has changed</h2>
<p>Hi @Model.UserName,</p>
<p>Your role in <strong>@Model.OrganizationName</strong> has been updated:</p>
<table style="border-collapse: collapse; margin: 16px 0;">
    <tr>
        <td style="padding: 8px 16px; border: 1px solid #e0e0e0; font-weight: bold;">Previous role</td>
        <td style="padding: 8px 16px; border: 1px solid #e0e0e0;">@Model.OldRole</td>
    </tr>
    <tr>
        <td style="padding: 8px 16px; border: 1px solid #e0e0e0; font-weight: bold;">New role</td>
        <td style="padding: 8px 16px; border: 1px solid #e0e0e0;">@Model.NewRole</td>
    </tr>
</table>
<p>If you believe this change was made in error, contact your organization administrator.</p>
