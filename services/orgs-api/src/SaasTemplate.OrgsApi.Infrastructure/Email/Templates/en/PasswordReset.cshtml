@model SaasTemplate.OrgsApi.Application.Common.Email.PasswordResetEmailModel
<h2>Reset your password</h2>
<p>We received a request to reset your password.</p>
<p>Use the button below to set a new password:</p>
<p>
    <a class="button" href="@Model.ResetUrl">Reset password</a>
</p>
<p>If the button does not work, copy this URL into your browser:</p>
<p><a href="@Model.ResetUrl">@Model.ResetUrl</a></p>
<p>This link expires in 15 minutes.</p>
