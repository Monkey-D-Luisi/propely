# Dev Dockerfile — uses full SDK image (not multi-stage) intentionally.
# The SDK is required for `dotnet watch` hot-reload during development.
# Production Dockerfiles (Dockerfile) use multi-stage builds with the
# slim aspnet runtime-only image (mcr.microsoft.com/dotnet/aspnet:10.0-alpine).
FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /src

# Restore dependencies first (layer caching)
COPY src/Propely.OrgsApi.Domain/Propely.OrgsApi.Domain.csproj src/Propely.OrgsApi.Domain/
COPY src/Propely.OrgsApi.Application/Propely.OrgsApi.Application.csproj src/Propely.OrgsApi.Application/
COPY src/Propely.OrgsApi.Infrastructure/Propely.OrgsApi.Infrastructure.csproj src/Propely.OrgsApi.Infrastructure/
COPY src/Propely.OrgsApi.Api/Propely.OrgsApi.Api.csproj src/Propely.OrgsApi.Api/
RUN dotnet restore src/Propely.OrgsApi.Api/Propely.OrgsApi.Api.csproj

COPY . .

EXPOSE 5020

ENV ASPNETCORE_ENVIRONMENT=Development
ENV ASPNETCORE_URLS=http://+:5020

ENTRYPOINT ["dotnet", "watch", "run", "--non-interactive", "--project", "src/Propely.OrgsApi.Api", "--no-launch-profile"]
