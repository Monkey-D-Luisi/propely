# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.md text
*.txt text
*.cs text
*.csproj text
*.sln text
*.json text
*.xml text
*.yml text
*.yaml text
*.sh text eol=lf
*.ps1 text eol=crlf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Scripts should use LF
*.sh text eol=lf
scripts/* text eol=lf
