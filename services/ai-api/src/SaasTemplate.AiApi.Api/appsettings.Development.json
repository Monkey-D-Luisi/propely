{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Security": {
    "AllowAnonymous": true
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "saastemplate",
    "Password": "",
    "VirtualHost": "/",
    "WorkItemsExchange": "workitems.events"
  },
  "OpenAi": {
    "ModelId": "gpt-5-mini"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Enabled": true,
    "DefaultTtlMinutes": 5,
    "KeyPrefix": "aiapi:"
  },
  "OutboxDispatcher": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "SaasTemplate.AiApi.Infrastructure.Messaging": "Debug"
    }
  }
}
