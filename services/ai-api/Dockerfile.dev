FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /src

# Restore dependencies first (layer caching)
COPY src/Propely.AiApi.Domain/Propely.AiApi.Domain.csproj src/Propely.AiApi.Domain/
COPY src/Propely.AiApi.Application/Propely.AiApi.Application.csproj src/Propely.AiApi.Application/
COPY src/Propely.AiApi.Infrastructure/Propely.AiApi.Infrastructure.csproj src/Propely.AiApi.Infrastructure/
COPY src/Propely.AiApi.Api/Propely.AiApi.Api.csproj src/Propely.AiApi.Api/
RUN dotnet restore src/Propely.AiApi.Api/Propely.AiApi.Api.csproj

COPY . .

EXPOSE 5010

ENV ASPNETCORE_ENVIRONMENT=Development
ENV ASPNETCORE_URLS=http://+:5010

ENTRYPOINT ["dotnet", "watch", "run", "--project", "src/Propely.AiApi.Api", "--no-launch-profile"]
