# Propely - Docker Compose Environment Overrides
#
# Applied AFTER .env via env_file: [.env, .env.docker]
# Only contains values that differ from .env (localhost -> container names).
# Secrets (e.g., OpenAI API key) flow through from .env automatically.
#
# This file is safe to commit (no secrets, only hostname changes).

# ============================
# ai-api Service — container network hostnames
# ============================
AIAPI_ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=propely_aiapi;Username=propely;Password=propely_dev_password
AIAPI_RabbitMQ__Host=rabbitmq
AIAPI_Redis__ConnectionString=redis:6379,password=propely_dev_password
AIAPI_OpenTelemetry__OtlpEndpoint=http://aspire-dashboard:18889

# ============================
# orgs-api Service — container network hostnames
# ============================
ORGSAPI_ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=propely_orgsapi;Username=propely;Password=propely_dev_password
ORGSAPI_RabbitMQ__Host=rabbitmq
ORGSAPI_Redis__ConnectionString=redis:6379,password=propely_dev_password
ORGSAPI_OpenTelemetry__OtlpEndpoint=http://aspire-dashboard:18889
ORGSAPI_Smtp__Host=mailhog
ORGSAPI_Smtp__Port=1025

# ============================
# properties-api Service (.NET) — Port 5030 — container network hostnames
# ============================
