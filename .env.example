# Propely - Environment Variables
#
# SETUP: Copy this file to .env and adjust values as needed.
#   cp .env.example .env          # Linux/macOS
#   Copy-Item .env.example .env   # Windows PowerShell
#
# The defaults work out-of-the-box for local development with Docker Compose.
# NEVER commit .env to version control.
#
# HOW IT WORKS:
# .NET services use prefix + __ section separator convention.
# AddEnvironmentVariables("AIAPI_") strips the prefix and maps __ to :
# e.g. AIAPI_RabbitMQ__Host → configuration["RabbitMQ:Host"]
#
# For full documentation of every variable, see docs/configuration.md

# ==============================================================================
# Shared Infrastructure
# ==============================================================================
# PostgreSQL — single instance, two databases (propely_aiapi, propely_orgsapi)
POSTGRES_USER=propely
POSTGRES_PASSWORD=propely_dev_password
POSTGRES_DB=propely

# RabbitMQ — message broker for inter-service events
RABBITMQ_USER=propely
RABBITMQ_PASSWORD=propely_dev_password

# Redis — caching layer for both services
REDIS_PASSWORD=propely_dev_password

# ==============================================================================
# ai-api Service (.NET) — Port 5010
# ==============================================================================

# --- Database ---
AIAPI_ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=propely_aiapi;Username=propely;Password=propely_dev_password

# --- Messaging ---
AIAPI_RabbitMQ__Host=localhost
AIAPI_RabbitMQ__Port=5672
AIAPI_RabbitMQ__Username=propely
AIAPI_RabbitMQ__Password=propely_dev_password

# --- Caching ---
AIAPI_Redis__ConnectionString=localhost:6379,password=propely_dev_password

# --- OpenAI (for AI-powered work item parsing) ---
# Get your API key at https://platform.openai.com/api-keys
# If empty, AI features degrade gracefully (parse returns raw text)
AIAPI_OpenAi__ApiKey=
# Model to use for AI parsing. Default: gpt-5-mini
AIAPI_OpenAi__ModelId=gpt-5-mini

# --- JWT (must match orgs-api values for cross-service auth) ---
# In dev mode, Security:AllowAnonymous=true bypasses JWT validation.
# For production: set the same secret as ORGSAPI_Jwt__Secret (min 32 chars).
#AIAPI_Jwt__Secret=
#AIAPI_Jwt__Issuer=orgs-api
#AIAPI_Jwt__Audience=propely

# --- Observability ---
AIAPI_OpenTelemetry__OtlpEndpoint=http://localhost:4317

# --- CORS ---
AIAPI_Cors__AllowedOrigins__0=http://localhost:3000
AIAPI_Cors__AllowedOrigins__1=http://127.0.0.1:3000

# ==============================================================================
# orgs-api Service (.NET) — Port 5020
# ==============================================================================

# --- Database ---
ORGSAPI_ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=propely_orgsapi;Username=propely;Password=propely_dev_password

# --- Messaging ---
ORGSAPI_RabbitMQ__Host=localhost
ORGSAPI_RabbitMQ__Port=5672
ORGSAPI_RabbitMQ__Username=propely
ORGSAPI_RabbitMQ__Password=propely_dev_password

# --- Caching ---
ORGSAPI_Redis__ConnectionString=localhost:6379,password=propely_dev_password

# --- JWT Authentication ---
# Secret for signing JWT tokens. REQUIRED in production (min 32 chars).
# In dev, appsettings.Development.json provides a default dev key.
# Generate a secure secret: openssl rand -base64 48
#ORGSAPI_Jwt__Secret=
#ORGSAPI_Jwt__Issuer=orgs-api
#ORGSAPI_Jwt__Audience=propely

# --- CSRF Protection ---
# Secret for CSRF double-submit cookie. Falls back to Jwt:Secret if not set.
# Set separately in production for defense-in-depth.
#ORGSAPI_Csrf__Secret=

# --- Cookie SameSite (cross-site deployments) ---
# Set to "None" when frontend and backend are on different registrable domains
# (e.g. separate .run.app subdomains). Defaults to "Lax" for same-site deployments.
#ORGSAPI_Cookie__SameSite=Lax

# --- OAuth Providers (optional) ---
# Leave empty to disable a provider. Only providers with both ClientId and
# ClientSecret configured will be registered.
# Google: https://console.cloud.google.com/apis/credentials
ORGSAPI_OAuth__Google__ClientId=
ORGSAPI_OAuth__Google__ClientSecret=
# GitHub: https://github.com/settings/developers
ORGSAPI_OAuth__GitHub__ClientId=
ORGSAPI_OAuth__GitHub__ClientSecret=

# --- Email ---
# Provider: "smtp" (default) or "sendgrid"
ORGSAPI_Email__Provider=smtp

# SMTP settings (used when Email:Provider=smtp)
# For local dev, Mailhog captures all emails at http://localhost:18025
# These defaults match the Docker Compose Mailhog service.
#ORGSAPI_Smtp__Host=localhost
#ORGSAPI_Smtp__Port=10025
#ORGSAPI_Smtp__From=no-reply@propely.test
#ORGSAPI_Smtp__EnableSsl=false

# SendGrid settings (used when Email:Provider=sendgrid)
# Get your API key at https://app.sendgrid.com/settings/api_keys
#ORGSAPI_SendGrid__ApiKey=
#ORGSAPI_SendGrid__From=no-reply@yourdomain.com
#ORGSAPI_SendGrid__FromName=Your Product Name

# --- Billing ---
# Mode: "free" (default, no Stripe needed) or "stripe" (enables Stripe integration)
ORGSAPI_Billing__Mode=free

# Stripe settings (required when Billing:Mode=stripe)
# Get your keys at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_*, pk_test_*) for development.
#ORGSAPI_Billing__Stripe__SecretKey=sk_test_...
#ORGSAPI_Billing__Stripe__PublishableKey=pk_test_...
# Webhook secret: stripe listen --forward-to localhost:5020/billing/webhook
#ORGSAPI_Billing__Stripe__WebhookSecret=whsec_...

# Stripe Price IDs for subscription plans (required for Stripe checkout)
# Create products/prices at https://dashboard.stripe.com/products
#ORGSAPI_Billing__Plans__0__StripePriceId=price_free_placeholder
#ORGSAPI_Billing__Plans__1__StripePriceId=price_pro_placeholder
#ORGSAPI_Billing__Plans__2__StripePriceId=price_enterprise_placeholder

# --- Frontend URL (for email links, OAuth redirects) ---
ORGSAPI_Auth__FrontendBaseUrl=http://localhost:3000

# --- Observability ---
ORGSAPI_OpenTelemetry__OtlpEndpoint=http://localhost:4317

# --- CORS ---
ORGSAPI_Cors__AllowedOrigins__0=http://localhost:3000
ORGSAPI_Cors__AllowedOrigins__1=http://127.0.0.1:3000

# --- Rate Limiting (optional, sensible defaults in appsettings.json) ---
# Uncomment to override default rate limits per endpoint.
#ORGSAPI_IpRateLimiting__GeneralRules__0__Endpoint=post:/auth/login
#ORGSAPI_IpRateLimiting__GeneralRules__0__Period=1m
#ORGSAPI_IpRateLimiting__GeneralRules__0__Limit=5

# --- Version / Update Check (optional) ---
# GitHub repo (owner/repo) for update checks. Leave empty to disable.
#ORGSAPI_Version__GitHubRepo=your-org/saas-starter-kit

# ==============================================================================
# web Frontend (Next.js) — Port 3000
# ==============================================================================
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_AI_API_URL=http://localhost:5010
NEXT_PUBLIC_ORGS_API_URL=http://localhost:5020
# App version (shown in admin UI, matches VERSION file at repo root)
NEXT_PUBLIC_APP_VERSION=1.0.0
