# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.md text
*.txt text
*.cs text
*.csproj text
*.sln text
*.json text
*.xml text
*.yml text
*.yaml text
*.sh text eol=lf
*.ps1 text eol=crlf
*.ts text
*.tsx text
*.js text
*.jsx text
*.css text
*.html text

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Shell scripts should use LF (*.ps1 keeps eol=crlf from above)
scripts/*.sh text eol=lf
